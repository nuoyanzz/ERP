# ============================================================
# 换行符与文件属性
# 统一按文本自动处理，避免 Windows / Linux 之间产生整文件差异
# ============================================================

* text=auto eol=lf

# ============================================================
# 明确按文本处理的类型
# ============================================================
*.java    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.drawio  text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# ============================================================
# 二进制文件不做换行转换
# ============================================================
*.jar     binary
*.zip     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.xlsx    binary
*.docx    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
